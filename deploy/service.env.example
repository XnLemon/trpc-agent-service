# Local-only values for the deployment quick start. Replace every credential
# before using a shared environment or a production deployment.
POSTGRES_DB=trpc_agent
POSTGRES_USER=trpc
POSTGRES_PASSWORD=trpc-local-password
TRPC_POSTGRES_DSN=postgres://trpc:trpc-local-password@postgres:5432/trpc_agent?sslmode=disable
TRPC_API_TOKEN=local-api-token
TRPC_TENANT_ID=t_01ARZ3NDEKTSV4RRFFQ69G5FAV
TRPC_APP_ID=app_01ARZ3NDEKTSV4RRFFQ69G5FAV
TRPC_ADMIN_TOKEN=local-admin-token
TRPC_ADMIN_TENANTS=*
TRPC_MODEL_API_KEY=local-development-key
TRPC_SESSION_BACKEND=postgres
TRPC_MODEL_PROVIDER=openai
TRPC_MODEL_NAMES=gpt-4o-mini
TRPC_MODEL_ENDPOINT_HOSTS=api.openai.com
TRPC_MODEL_SECRET_REF=env/trpc-model-api-key
TRPC_HTTP_PORT=8080

# Optional OTLP/HTTP export. Empty endpoint keeps the no-op provider.
OTEL_SERVICE_NAME=trpc-agent-service
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_INSECURE=false
